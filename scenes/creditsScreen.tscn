[ext_resource type="Texture2D" path="res://assets/icons/leafDivider.svg" id="7_divider"]

[sub_resource type="Shader" id="Shader_fade"]
code = "shader_type canvas_item;

// Fades the end titles in at the bottom and out at the top
uniform float fadeHeight = 148.0;

void fragment() {
	float fade = fadeHeight * TEXTURE_PIXEL_SIZE.y;
	COLOR.a *= smoothstep(0.0, fade, UV.y) * smoothstep(1.0, 1.0 - fade, UV.y);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fade"]
shader = SubResource("Shader_fade")

