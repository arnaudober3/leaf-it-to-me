[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/creditsScreen.gd" id="1_script"]
[ext_resource type="FontVariation" path="res://assets/fonts/fredokaSemiBold.tres" id="2_name"]
[ext_resource type="FontVariation" path="res://assets/fonts/fredokaBold.tres" id="3_title"]
